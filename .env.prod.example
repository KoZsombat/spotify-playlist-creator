# Values for docker-compose.prod.yml / Launchpad project environment.
# BETTER_AUTH_URL is the exact public origin created by Launchpad on the
# Cloudflare Tunnel, e.g. https://crate.<BASE_DOMAIN> — no trailing slash.
BETTER_AUTH_URL=https://crate.example.com
BETTER_AUTH_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
POSTGRES_PASSWORD=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels). The tunnel's
# public hostname for this app must target http://app:3000 (dedicated tunnel) or
# http://traefik:80 (Launchpad's wildcard).
TUNNEL_TOKEN=

# Optional: search market when the brief names no language (default US).
SPOTIFY_MARKET=US

# Optional: OpenAI-compatible interpretation layer (local parser is used when empty).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
