# --- Core ---
# Spotify refuses `localhost` redirect URIs; always use 127.0.0.1.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-32-bytes-of-randomness

# --- Spotify app (https://developer.spotify.com/dashboard) ---
# Redirect URI to add in the Spotify dashboard:
#   http://127.0.0.1:3000/api/auth/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Postgres (docker compose maps 5433 -> 5432) ---
DATABASE_URL=postgres://playlist:playlist@127.0.0.1:5433/playlist_creator

# --- Optional: smarter description interpretation ---
# Any OpenAI-compatible chat completions endpoint. When unset, a deterministic
# local parser handles descriptions (see README).
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
