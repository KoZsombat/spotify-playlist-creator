{
  "name": "spotify-playlist-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "bun run scripts/migrate.ts",
    "setup": "bun run db:up && bun run db:migrate",
    "build:migrate": "bun build scripts/migrate.ts --target=node --outfile=dist/migrate.mjs",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "lucide-react": "^0.545.0",
    "next": "15.5.29",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
